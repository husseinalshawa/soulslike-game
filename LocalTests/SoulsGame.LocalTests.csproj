<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Local test harness: compiles the SAME game sources and test sources that
    Unity compiles, against a thin UnityEngine shim (UnityShim/), so the full
    logic suite runs in this container where the Unity Editor is unavailable.
    Unity itself never sees this folder (it lives outside Assets/).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="UnityShim/**/*.cs" />
    <Compile Include="../Assets/_Game/Scripts/**/*.cs" Exclude="../Assets/_Game/Scripts/Editor/**/*.cs" />
    <Compile Include="../Assets/_Game/Tests/EditMode/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
